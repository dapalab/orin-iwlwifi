 #include <linux/firmware.h>
 #include <linux/rtnetlink.h>
 #include "iwl-trans.h"
@@ -568,6 +569,38 @@ exit:
 	return resp_cp;
 }
 
+/*
+ * The country module parameter, if it is a usable ISO 3166 alpha-2 code.
+ * Without a BIOS (ACPI) country the firmware starts on the world domain,
+ * which leaves 6 GHz off, and guesses the country from nearby beacons again
+ * whenever it is not associated. A fixed country avoids both.
+ */
+static bool iwl_mvm_fixed_country(char *mcc)
+{
+	const char *c = iwlmvm_mod_params.country;
+
+	if (!c || !isalpha(c[0]) || !isalpha(c[1]) || c[2] ||
+	    (toupper(c[0]) == 'Z' && toupper(c[1]) == 'Z'))
+		return false;
+
+	if (mcc) {
+		mcc[0] = toupper(c[0]);
+		mcc[1] = toupper(c[1]);
+		mcc[2] = '\0';
+	}
+	return true;
+}
+
+/* The source the fixed country is set with: as the SET_COUNTRY vendor command */
+static enum iwl_mcc_source iwl_mvm_fixed_country_src(struct iwl_mvm *mvm)
+{
+	if (!iwl_mvm_is_wifi_mcc_supported(mvm))
+		return MCC_SOURCE_OLD_FW;
+
+	return mvm->trans->mac_cfg->device_family > IWL_DEVICE_FAMILY_9000 ?
+		MCC_SOURCE_MCC_API : MCC_SOURCE_3G_LTE_HOST;
+}
+
 int iwl_mvm_init_mcc(struct iwl_mvm *mvm)
 {
 	bool tlv_lar;
@@ -619,6 +652,24 @@ int iwl_mvm_init_mcc(struct iwl_mvm *mvm)
 			return -EIO;
 	}
 
+	/*
+	 * Set the fixed country the way the SET_COUNTRY vendor command does.
+	 * Later firmware starts replay it (iwl_mvm_init_fw_regd() above).
+	 */
+	if (iwl_mvm_fixed_country(mcc)) {
+		kfree(regd);
+		regd = iwl_mvm_get_regdomain(mvm->hw->wiphy, mcc,
+					     iwl_mvm_fixed_country_src(mvm),
+					     NULL);
+		if (IS_ERR_OR_NULL(regd))
+			return -EIO;
+		IWL_INFO(mvm, "regulatory country fixed to %s (country module parameter)\n",
+			 mcc);
+	} else if (iwlmvm_mod_params.country) {
+		IWL_WARN(mvm, "ignoring country module parameter '%s': not an ISO 3166 alpha-2 code\n",
+			 iwlmvm_mod_params.country);
+	}
+
 	retval = regulatory_set_wiphy_regd_sync(mvm->hw->wiphy, regd);
 
 	kfree(regd);
@@ -631,13 +682,33 @@ void iwl_mvm_rx_chub_update_mcc(struct iwl_mvm *mvm,
 	struct iwl_rx_packet *pkt = rxb_addr(rxb);
 	struct iwl_mcc_chub_notif *notif = (void *)pkt->data;
 	enum iwl_mcc_source src;
-	char mcc[3];
+	char mcc[3], fixed[3];
 	struct ieee80211_regdomain *regd;
 	int wgds_tbl_idx;
 	bool changed = false;
 
 	lockdep_assert_held(&mvm->mutex);
 
+	if (iwl_mvm_fixed_country(fixed)) {
+		/*
+		 * By the time this arrives the firmware has already switched
+		 * to the country it guessed from nearby beacons, whatever the
+		 * host does with it, and it guesses again every few seconds
+		 * while not associated. Set the fixed country again, or the
+		 * firmware keeps its guess (and possibly no 6 GHz) until it
+		 * restarts, while the host still shows the fixed country.
+		 */
+		IWL_DEBUG_LAR(mvm,
+			      "Firmware chose mcc 0x%04x (src %d), setting %s again\n",
+			      le16_to_cpu(notif->mcc), notif->source_id, fixed);
+		regd = iwl_mvm_get_regdomain(mvm->hw->wiphy, fixed,
+					     iwl_mvm_fixed_country_src(mvm),
+					     NULL);
+		if (!IS_ERR_OR_NULL(regd))
+			kfree(regd);
+		return;
+	}
+
 	if (iwl_mvm_is_vif_assoc(mvm) && notif->source_id == MCC_SOURCE_WIFI) {
 		IWL_DEBUG_LAR(mvm, "Ignore mcc update while associated\n");
 		return;
